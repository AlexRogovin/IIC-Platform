  --navy-900: #07365f;
  --navy-800: #0b4773;
  --navy-700: #14598a;
  --teal-700: #087f91;
  --teal-600: #0d91a1;
  --teal-100: #d9f2f5;
  --blue-100: #e9f3fb;
  --ink: #102c4c;
  --muted: #61748a;
  --line: #d5dee7;
  --line-soft: #e7edf2;
