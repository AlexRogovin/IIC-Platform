* { box-sizing: border-box; }

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: #f7f9fb;
  -webkit-font-smoothing: antialiased;
}

button, input, textarea { font: inherit; }
button { color: inherit; }
button:focus-visible, input:focus-visible, textarea:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }

.app-shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 216px minmax(0, 1fr);
  grid-template-rows: 58px minmax(0, 1fr);
  background: #f8fafc;
}

.app-shell--collapsed { grid-template-columns: 68px minmax(0, 1fr); }

.topbar {
  grid-column: 1 / -1;
  grid-row: 1;
  background: var(--navy-950);
  color: white;
  display: flex;
  align-items: center;
  min-width: 0;
  border-bottom: 1px solid rgba(255,255,255,.14);
  position: sticky;
  top: 0;
  z-index: 40;
}

.logo {
  width: 216px;
  height: 58px;
  flex: 0 0 216px;
  padding: 0 20px;
  display: flex;
  align-items: center;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -.4px;
  border-right: 1px solid rgba(255,255,255,.13);
}

.logo span { color: #40b4be; font-family: Georgia, "Times New Roman", serif; font-weight: 700; letter-spacing: -.7px; }
.corridor-title { padding: 0 20px; font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.topbar-controls { margin-left: auto; display: flex; align-items: center; height: 100%; }
.environment-chip, .date-chip { display: inline-flex; align-items: center; gap: 7px; padding: 0 14px; height: 100%; font-size: 12px; font-weight: 600; border-left: 1px solid rgba(255,255,255,.14); white-space: nowrap; }
.environment-chip svg, .date-chip svg { width: 15px; height: 15px; }
.profile-button { width: 34px; height: 34px; margin: 0 16px; border: 0; border-radius: 50%; background: #eef3f7; color: var(--navy-950); font-size: 12px; font-weight: 700; cursor: pointer; }
.mobile-menu { display: none; background: transparent; border: 0; color: white; margin-left: 8px; padding: 8px; }

.sidebar {
  grid-column: 1;
  grid-row: 2;
  min-height: calc(100vh - 58px);
  background: var(--navy-950);
  color: #eef7ff;
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 58px;
  height: calc(100vh - 58px);
  z-index: 30;
  overflow: hidden;
}

.tenant-block { min-height: 76px; display: flex; align-items: center; gap: 10px; padding: 13px 17px; border-bottom: 1px solid rgba(255,255,255,.12); }
.tenant-icon { width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,.14); display: grid; place-items: center; flex: 0 0 34px; }
.tenant-icon svg { width: 18px; }
.tenant-block strong { display: block; font-size: 12px; line-height: 1.35; }
.tenant-block span { display: block; font-size: 10px; color: #c3d4e3; margin-top: 2px; }
.sidebar nav { padding: 8px 0; }
.nav-item, .collapse-button { width: 100%; height: 48px; display: flex; align-items: center; gap: 12px; padding: 0 18px; border: 0; background: transparent; color: #eef7ff; text-align: left; cursor: pointer; position: relative; font-size: 13px; font-weight: 600; }
.nav-item svg, .collapse-button svg { width: 18px; height: 18px; flex: 0 0 18px; stroke-width: 1.9; }
.nav-item:hover, .collapse-button:hover { background: rgba(255,255,255,.08); }
.nav-item--active { background: #0f6f91; }
.nav-item--active::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: #35d0cf; }
.nav-count { margin-left: auto; min-width: 22px; height: 22px; padding: 0 6px; border-radius: 11px; display: grid; place-items: center; background: #f4a900; color: #17283d; font-size: 11px; font-weight: 800; }
.sidebar-bottom { margin-top: auto; padding-bottom: 10px; border-top: 1px solid rgba(255,255,255,.12); }
.collapse-button { color: #bfd1df; font-weight: 500; }
.sidebar--collapsed .tenant-block { padding-inline: 17px; }
.sidebar--collapsed .nav-item, .sidebar--collapsed .collapse-button { padding-inline: 25px; }

.case-page, .placeholder-page {
  grid-column: 2;
  grid-row: 2;
  min-width: 0;
  padding: 14px 24px 8px;
  background: #fbfcfd;
}

.back-link, .text-button { border: 0; background: transparent; color: #155b8e; display: inline-flex; align-items: center; gap: 7px; padding: 5px 0; font-size: 12px; cursor: pointer; }
.back-link svg { width: 15px; }
.case-heading { margin-top: 6px; }
.title-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
h1 { font-size: 25px; line-height: 1.15; margin: 0; color: #12304f; letter-spacing: -.45px; }
.state-chip { display: inline-flex; align-items: center; gap: 6px; background: var(--amber-soft); color: #795200; border: 1px solid #f0d394; border-radius: 4px; padding: 6px 10px; font-size: 11px; font-weight: 700; }
.state-chip svg { width: 14px; height: 14px; }
.case-meta { display: grid; grid-template-columns: repeat(6, minmax(110px, 1fr)); gap: 20px; padding: 18px 0 15px; }
.meta-item span { display: block; color: var(--muted); font-size: 10px; margin-bottom: 5px; }
.meta-item strong { display: block; font-size: 13px; font-weight: 650; color: #193653; }

.tabs { height: 42px; display: flex; gap: 4px; border-bottom: 1px solid #bcc9d5; }
.tabs button { border: 0; background: transparent; padding: 0 14px; color: #526b82; font-size: 12px; font-weight: 600; cursor: pointer; position: relative; }
.tabs button:hover { color: var(--navy-700); }
.tabs .tab--active { color: var(--navy-800); }
.tabs .tab--active::after { content: ""; position: absolute; left: 10px; right: 10px; bottom: -1px; height: 3px; background: #12638f; }

.content-grid { display: grid; grid-template-columns: minmax(650px, 1fr) 290px; gap: 18px; padding-top: 12px; align-items: start; }
.main-card, .side-card { background: var(--surface); border: 1px solid var(--line); border-radius: 4px; }
.main-card { min-width: 0; overflow: hidden; }
.main-card-header { min-height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 14px 18px; border-bottom: 1px solid var(--line); }
.main-card-header h2, .side-card h2 { margin: 0; font-size: 16px; line-height: 1.3; }
.main-card-header p, .side-card p { margin: 4px 0 0; color: var(--muted); font-size: 11px; }
.header-actions { display: flex; gap: 10px; }
.primary-button, .secondary-button { min-height: 38px; border-radius: 3px; padding: 0 14px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-size: 12px; font-weight: 700; cursor: pointer; white-space: nowrap; }
.primary-button { border: 1px solid var(--navy-800); background: var(--navy-800); color: white; }
.primary-button:hover { background: var(--navy-700); }
.primary-button:disabled { background: #aab8c4; border-color: #aab8c4; cursor: not-allowed; }
.secondary-button { border: 1px solid #3573a3; background: white; color: #155b8e; }
.secondary-button:hover { background: #f0f7fc; }
.primary-button svg, .secondary-button svg { width: 16px; height: 16px; }

.evidence-columns { display: grid; grid-template-columns: minmax(280px, 1.55fr) minmax(110px, .7fr) minmax(130px, .75fr) minmax(92px, .55fr); align-items: center; column-gap: 16px; }
.evidence-columns--head { min-height: 38px; padding: 0 18px; background: #f4f7f9; border-bottom: 1px solid var(--line); color: #536b82; font-size: 10px; font-weight: 700; }
.evidence-group { border-bottom: 1px solid var(--line); }
.evidence-group:last-child { border-bottom: 0; }
.group-heading { width: 100%; min-height: 44px; display: grid; grid-template-columns: 24px minmax(250px, 1fr) auto 18px; align-items: center; gap: 8px; padding: 0 16px; border: 0; background: #f7f9fb; color: #173a5d; text-align: left; cursor: pointer; }
.group-heading:hover { background: #eef4f7; }
.group-title { font-size: 12px; font-weight: 750; }
.group-summary { color: #526b82; font-size: 10px; }
.group-tone svg { width: 14px; height: 14px; }
.group-tone--complete { color: var(--green); }
.group-tone--warning { color: var(--amber); }
.group-tone--neutral { color: #6d8092; }
.group-heading > svg { width: 16px; transition: transform .15s ease; }
.group-heading > .chevron--open { transform: rotate(180deg); }
.evidence-row { min-height: 38px; padding: 0 18px 0 40px; color: #3c5369; font-size: 11px; border-top: 1px solid var(--line-soft); }
.evidence-row:hover { background: #f9fcfd; }
.item-name, .status { display: flex; align-items: center; gap: 8px; }
.item-name svg, .status svg { width: 14px; height: 14px; flex: 0 0 14px; }
.item-name > svg { color: #507189; }
.status--completed { color: var(--green); }
.status--missing { color: #a76400; font-weight: 700; }
.status--not-started { color: #64798c; }

.right-column { display: grid; gap: 12px; }
.side-card { padding: 14px; }
.side-card-title { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.side-card-title svg { width: 16px; height: 16px; color: #4d677e; }
.integrity-list, .access-list { margin: 12px 0 0; }
.integrity-list > div, .access-list > div { display: flex; justify-content: space-between; gap: 10px; padding: 7px 0; border-top: 1px solid var(--line-soft); font-size: 10px; }
.integrity-list dt, .access-list dt { display: flex; align-items: center; gap: 7px; color: #334e68; }
.integrity-list dt svg { width: 14px; height: 14px; color: #315675; }
.integrity-list dd, .access-list dd { margin: 0; color: #536b82; text-align: right; }
.text-button { font-weight: 650; margin-top: 5px; }
.text-button svg { width: 14px; height: 14px; }
.timeline { list-style: none; padding: 2px 0 0 14px; margin: 12px 0 0; border-left: 1px solid #c3d1dc; }
.timeline li { position: relative; padding: 0 0 13px 10px; display: grid; gap: 2px; }
.timeline li::before { content: ""; position: absolute; width: 7px; height: 7px; border-radius: 50%; background: white; border: 1.5px solid #56748d; left: -18px; top: 3px; }
.timeline time, .timeline small { color: #607589; font-size: 9px; }
.timeline strong { font-size: 10px; }
.timeline span { color: #526b82; font-size: 9px; line-height: 1.4; }

.tab-content { min-height: 620px; }
.overview-banner { display: flex; gap: 12px; margin: 18px; padding: 16px; background: var(--amber-soft); border-left: 4px solid var(--amber); }
.overview-banner svg { width: 20px; flex: 0 0 20px; color: var(--amber); }
.overview-banner strong, .overview-banner span { display: block; }
.overview-banner strong { font-size: 13px; }
.overview-banner span { font-size: 11px; color: #63583e; margin-top: 4px; }
.overview-sections { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding: 0 18px 18px; }
.overview-sections section { border-top: 1px solid var(--line); padding-top: 14px; }
.overview-sections h3 { margin: 0 0 10px; font-size: 13px; }
.overview-sections p { font-size: 12px; line-height: 1.6; color: #4d6478; }
.overview-sections dl { margin: 0; }
.overview-sections dl div { display: flex; justify-content: space-between; gap: 18px; padding: 8px 0; border-bottom: 1px solid var(--line-soft); font-size: 11px; }
.overview-sections dd { margin: 0; font-weight: 650; text-align: right; }
.empty-state { min-height: 450px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #6d8193; text-align: center; padding: 40px; }
.empty-state svg { width: 38px; height: 38px; stroke-width: 1.3; }
.empty-state h3 { margin: 14px 0 5px; color: #294963; font-size: 15px; }
.empty-state p { max-width: 360px; margin: 0; font-size: 11px; line-height: 1.55; }
.communication-row { display: grid; grid-template-columns: 40px 1fr auto; align-items: center; gap: 12px; padding: 16px 18px; border-bottom: 1px solid var(--line-soft); }
.communication-icon { width: 36px; height: 36px; background: var(--blue-100); display: grid; place-items: center; color: var(--navy-700); border-radius: 50%; }
.communication-icon svg { width: 17px; }
.communication-row strong, .communication-row span, .communication-row small { display: block; }
.communication-row strong { font-size: 12px; }
.communication-row span { font-size: 11px; color: var(--muted); margin-top: 2px; }
.communication-row small { font-size: 9px; color: #7a8b9b; margin-top: 4px; }
.delivery-state { display: flex !important; gap: 5px; align-items: center; color: var(--green) !important; font-weight: 700; }
.delivery-state svg { width: 14px; }
.history-list { list-style: none; margin: 0; padding: 14px 18px; }
.history-list li { display: grid; grid-template-columns: 36px 1fr; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line-soft); }
.history-marker { width: 30px; height: 30px; border-radius: 50%; background: var(--blue-100); display: grid; place-items: center; color: var(--navy-700); }
.history-marker svg { width: 15px; }
.history-list time, .history-list strong, .history-list small { display: block; }
.history-list time { font-size: 9px; color: #708294; }
.history-list strong { font-size: 12px; margin-top: 3px; }
.history-list p { margin: 4px 0; font-size: 11px; color: #526b82; }
.history-list small { font-size: 9px; color: #708294; }
.page-footer { display: flex; justify-content: space-between; gap: 16px; color: #78899a; font-size: 9px; padding: 8px 4px 0; }

.modal-backdrop { position: fixed; inset: 0; z-index: 80; background: rgba(2, 23, 43, .5); display: grid; place-items: center; padding: 24px; }
.modal { width: min(600px, calc(100vw - 32px)); max-height: calc(100vh - 48px); overflow: auto; background: white; border-radius: 5px; box-shadow: 0 18px 55px rgba(3, 31, 56, .28); }
.modal--compact { width: min(520px, calc(100vw - 32px)); }
.modal-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding: 18px 20px; border-bottom: 1px solid var(--line); }
.eyebrow { display: block; font-size: 9px; letter-spacing: .1em; font-weight: 800; color: #6a7e90; margin-bottom: 5px; }
.modal h2 { margin: 0; font-size: 19px; }
.icon-button { width: 34px; height: 34px; border: 0; background: transparent; display: grid; place-items: center; cursor: pointer; }
.icon-button:hover { background: #eef4f7; }
.icon-button svg { width: 18px; }
.modal-intro { margin: 0; padding: 14px 20px; color: #526b82; font-size: 11px; line-height: 1.5; }
.modal fieldset { border: 0; padding: 0 20px; margin: 0; }
.modal legend { width: 100%; font-size: 11px; font-weight: 750; padding: 0 0 8px; border-bottom: 1px solid var(--line); }
.check-row { display: grid; grid-template-columns: 20px 1fr; gap: 10px; align-items: center; padding: 11px 0; border-bottom: 1px solid var(--line-soft); cursor: pointer; position: relative; }
.check-row input { position: absolute; opacity: 0; }
.custom-check { width: 18px; height: 18px; border: 1px solid #7890a3; border-radius: 2px; display: grid; place-items: center; }
.custom-check svg { width: 13px; opacity: 0; }
.check-row input:checked + .custom-check { background: var(--navy-700); border-color: var(--navy-700); color: white; }
.check-row input:checked + .custom-check svg { opacity: 1; }
.check-row input:focus-visible + .custom-check { outline: 3px solid var(--focus); outline-offset: 2px; }
.check-row strong, .check-row small { display: block; }
.check-row strong { font-size: 11px; }
.check-row small { margin-top: 2px; font-size: 9px; color: #6d8092; }
.message-label { display: grid; gap: 6px; margin: 14px 20px; font-size: 11px; font-weight: 750; }
.message-label textarea { min-height: 84px; padding: 10px; resize: vertical; border: 1px solid #aab9c6; border-radius: 3px; color: #28465f; font-size: 11px; line-height: 1.5; }
.modal-notice, .review-boundary { margin: 0 20px 14px; padding: 10px 12px; display: flex; gap: 9px; align-items: flex-start; background: var(--blue-100); color: #37566f; font-size: 10px; line-height: 1.5; }
.modal-notice svg, .review-boundary svg { width: 15px; flex: 0 0 15px; }
.review-boundary { margin-top: 16px; }
.modal-actions { display: flex; justify-content: flex-end; gap: 10px; padding: 14px 20px; border-top: 1px solid var(--line); background: #f7f9fb; }
.toast { position: fixed; right: 24px; bottom: 22px; z-index: 100; display: flex; align-items: center; gap: 9px; min-width: 280px; padding: 13px 16px; background: #123d5f; color: white; border-left: 4px solid #3bc5bb; box-shadow: 0 10px 26px rgba(8, 38, 64, .2); font-size: 12px; font-weight: 650; }
.toast svg { width: 18px; }

.placeholder-page { display: grid; place-items: center; position: relative; }
.placeholder-page > .back-link { position: absolute; top: 18px; left: 24px; }
.placeholder-panel { width: min(520px, 90vw); text-align: center; padding: 48px 36px; background: white; border: 1px solid var(--line); }
.placeholder-icon { width: 52px; height: 52px; margin: 0 auto 18px; display: grid; place-items: center; background: var(--blue-100); color: var(--navy-700); border-radius: 50%; }
.placeholder-icon svg { width: 24px; }
.placeholder-panel h1 { margin: 6px 0 12px; }
.placeholder-panel p { margin: 0 auto 22px; max-width: 390px; color: var(--muted); font-size: 12px; line-height: 1.6; }

.mobile-scrim { display: none; }

@media (max-width: 1180px) {
  .environment-chip:first-child, .date-chip { display: none; }
  .case-meta { grid-template-columns: repeat(3, 1fr); row-gap: 12px; }
  .content-grid { grid-template-columns: minmax(600px, 1fr) 250px; }
  .evidence-columns { grid-template-columns: minmax(240px, 1.35fr) minmax(90px, .55fr) minmax(115px, .65fr) 80px; gap: 10px; }
}

@media (max-width: 920px) {
  .app-shell, .app-shell--collapsed { grid-template-columns: 1fr; }
  .topbar { grid-column: 1; }
  .logo { width: auto; flex-basis: auto; padding-left: 8px; border-right: 0; }
  .mobile-menu { display: grid; place-items: center; }
  .corridor-title { display: none; }
  .sidebar { position: fixed; left: 0; top: 58px; width: 216px; transform: translateX(-100%); transition: transform .18s ease; }
  .app-shell--mobile-open .sidebar { transform: translateX(0); }
  .app-shell--mobile-open .mobile-scrim { display: block; position: fixed; inset: 58px 0 0; z-index: 25; border: 0; background: rgba(3, 29, 51, .42); }
  .case-page, .placeholder-page { grid-column: 1; }
  .content-grid { grid-template-columns: 1fr; }
  .right-column { grid-template-columns: repeat(3, 1fr); }
  .tab-content { min-height: auto; }
}

@media (max-width: 680px) {
  .topbar-controls .environment-chip { display: none; }
  .profile-button { margin-inline: 8px; }
  .case-page, .placeholder-page { padding: 12px; }
  h1 { font-size: 21px; }
  .case-meta { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .tabs { overflow-x: auto; }
  .tabs button { flex: 0 0 auto; }
  .main-card-header { align-items: flex-start; flex-direction: column; }
  .header-actions { width: 100%; }
  .header-actions button { flex: 1; }
  .evidence-columns--head { display: none; }
  .evidence-row { grid-template-columns: 1fr auto; gap: 6px 12px; padding: 10px 14px 10px 36px; }
  .evidence-row > :nth-child(2) { display: none; }
  .evidence-row > :nth-child(4) { grid-column: 2; font-size: 9px; }
  .group-heading { grid-template-columns: 22px 1fr 18px; padding: 0 12px; }
  .group-summary { display: none; }
  .right-column { grid-template-columns: 1fr; }
  .overview-sections { grid-template-columns: 1fr; }
  .page-footer { flex-direction: column; }
}
